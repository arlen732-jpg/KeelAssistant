{
  // Keel Assistant 設定檔範本
  // 使用方式：複製本檔為 appsettings.json，再依本機環境調整下列值。
  // appsettings.json 本身不進版控（見 .gitignore）。

  // ── HTTP API（僅綁 127.0.0.1，避開 IIS 的 80/443/8080）──
  "ApiPort": 38600,

  // ── 鬧鐘 ──
  "AlarmSoundPath": "assets/alarm.wav",  // 鬧鈴音檔（相對程式目錄，循環播放直到手動停止）

  // ── 會議錄音 / 事後逐字稿（Whisper）──
  // 模型檔不隨程式發佈（約 1.5GB），由 MCP 的 download_whisper_model 按需下載。
  // 檔案不存在時僅停用轉逐字稿，不影響錄音本身。
  "TranscriptionModelPath": "models/ggml-medium.bin",

  // ── Python 沙盒（Pyodide / WebAssembly）──
  // 沙盒無網路、碰不到真實檔案系統；唯一接觸磁碟的是 SandboxRoot 之下的 input（唯讀）與 output（寫回）。
  // 路徑刻意與專案目錄平行，不放在專案內——路徑驗證一旦有疏漏，逃逸的第一站不該是放憑證的地方。
  "SandboxRoot": "C:\\path\\to\\_sandbox",
  "SandboxTimeoutSeconds": 30,          // 單次執行上限，逾時硬殺 Worker
  "SandboxMemoryLimitMb": 1024,         // WebView2 行程群組相對基準值的記憶體上限
  "SandboxMaxFileSizeMb": 50,           // 單一輸入檔上限
  "SandboxIdleShutdownMinutes": 5,      // 閒置多久銷毀 WebView2（0 = 用完立即銷毀）

  // readPaths 可用絕對路徑（免得每次都要先把資料 copy 進 input）。讀取本身不會破壞環境，
  // 要防的是內容進入對話後上傳，因此改由「黑名單硬擋 + 沙盒外路徑跳紅字確認視窗」把關。
  // 命中以下樣式者連視窗都不跳，直接拒絕——這道防線刻意不給人為放行的機會。
  // 比對完整路徑，支援 * ?，不分大小寫。要放行某類檔案就從這裡移除。
  "SandboxDenyPatterns": [
    "*\\dbconnections.json",
    "*\\.credentials.json",
    "*\\credentials.json",
    "*\\secrets.json",
    "*\\appsettings*.json",
    "*\\web.config",
    "*\\.env",
    "*\\.env.*",
    "*\\.ssh\\*",
    "*\\.aws\\*",
    "*\\id_rsa*",
    "*.pfx",
    "*.p12",
    "*.key",
    "*.pem"
  ],

  // ── SSH 遠端執行 ──
  // ⚠️ 這是三個高風險模組中唯一「沒有隔離層」的：SQL 有唯讀帳號＋唯讀交易，Python 有 WASM 邊界，
  //    SSH 送過去就是遠端主機上的真實指令。因此預設關閉，且每一條指令都會跳確認視窗（不做白名單）。
  // 連線設定（主機／帳號／金鑰）存 sshconnections.json，只能透過托盤選單「SSH 連線設定」維護
  // ——密碼與 passphrase 以 DPAPI 加密，手動編輯該檔無法產生正確密文。
  "SshEnabled": false,
  "SshDefaultTimeoutSeconds": 120,      // 單條指令預設逾時；MCP 參數可在 1~1800 覆寫
  "SshIdleShutdownMinutes": 30,         // 閒置多久自動斷線（0 = 不自動斷）
  "SshMaxOutputChars": 8000,            // 回傳給 Claude 的輸出上限，超過標記 truncated
  "SshTerminalCols": 120,               // 終端欄數（同時決定 PTY 寬度，改後需重新連線）
  "SshTerminalRows": 32,
  "SshTerminalFontSize": 14,

  // ── Windows 通知監看（LINE 漏看防護）──
  // 輪詢通知中心（UserNotificationListener），命中規則時跳置頂視窗。
  // 前置條件：① 設定→隱私權與安全性→通知 已允許本程式 ② LINE 為市集版
  // ③ LINE 未關閉「訊息預覽」（關閉後內文只剩「你有一則新訊息」，內文比對會失效）
  "NotificationWatchEnabled": true,
  "NotificationScanSeconds": 3,
  "NotificationApps": [ "LINE" ],                      // 只看這些 App（比對 AppUserModelId 與顯示名稱）

  // 強訊號 → 置頂視窗 + 音效
  "NotificationSenders": [ "關鍵聯絡人顯示名稱" ],       // 標題或內文命中（群組發言時發話者在內文，故兩處都比）
  "NotificationMentions": [ "@你的LINE顯示名稱" ],      // 被明確 @ ，填 LINE 顯示名稱而非英文本名

  // 弱訊號 → 只跳氣泡（閒聊提到也會命中，故不給它打斷畫面的權力）
  "NotificationKeywords": [ "你的名字" ],

  "NotificationCooldownSeconds": 120,                  // 同一聊天室的重複提醒間隔

  // ── Claude 用量監控（沿用 ClaudeUsageMonitor）──
  "PollIntervalSeconds": 300,        // OAuth usage API 輪詢間隔（硬限 >=180）
  "WarnThresholdPercent": 80,        // 達此百分比跳第一次通知
  "CriticalThresholdPercent": 95,    // 達此百分比跳第二次通知
  "OAuthClientId": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"  // Claude Code 公開 OAuth client_id（refresh token 用）
}
