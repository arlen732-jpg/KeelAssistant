{
  // 每百萬 token 單價（USD）。官方調價時請自行更新。
  // 欄位：input / output / cacheWrite(5m) / cacheRead
  // model 比對用「包含」方式：JSONL 的 model 字串含此 key 即套用。
  // 由上而下取第一筆命中，因此「版本較精確的 key」必須排在「通用 key」之前。
  // 2026/10/01 - Arlen - 依官方定價更新（Fable 5.1 / Opus 5.5 / Sonnet 5.5 等新模型）
  "models": [
    { "match": "fable-5-1",   "input": 10.0, "output": 50.0, "cacheWrite": 12.5,  "cacheRead": 0.25 },
    { "match": "mythos-5-1",  "input": 10.0, "output": 50.0, "cacheWrite": 12.5,  "cacheRead": 0.25 },
    { "match": "fable",       "input": 10.0, "output": 50.0, "cacheWrite": 12.5,  "cacheRead": 1.0 },
    { "match": "mythos",      "input": 10.0, "output": 50.0, "cacheWrite": 12.5,  "cacheRead": 1.0 },
    { "match": "opus-5-5",    "input": 4.0,  "output": 20.0, "cacheWrite": 5.0,   "cacheRead": 0.2 },
    { "match": "opus-4-1",    "input": 15.0, "output": 75.0, "cacheWrite": 18.75, "cacheRead": 1.5 },
    { "match": "opus-4-2025", "input": 15.0, "output": 75.0, "cacheWrite": 18.75, "cacheRead": 1.5 },
    { "match": "opus",        "input": 5.0,  "output": 25.0, "cacheWrite": 6.25,  "cacheRead": 0.5 },
    { "match": "sonnet-5",    "input": 2.0,  "output": 10.0, "cacheWrite": 2.5,   "cacheRead": 0.2 },
    { "match": "sonnet",      "input": 3.0,  "output": 15.0, "cacheWrite": 3.75,  "cacheRead": 0.3 },
    { "match": "haiku",       "input": 1.0,  "output": 5.0,  "cacheWrite": 1.25,  "cacheRead": 0.1 }
  ],
  "default": { "match": "*", "input": 3.0, "output": 15.0, "cacheWrite": 3.75, "cacheRead": 0.3 }
}
